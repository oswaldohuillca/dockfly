---
import Base from '../layouts/Base.astro'
import Hero from '../components/Hero.astro'
import Facts from '../components/Facts.astro'
import Features from '../components/Features.astro'
import Install from '../components/Install.astro'

import { repo } from '../consts'

const title = 'Dockfly — self-hosted PaaS for Docker, on your own server'
const description =
  'Dockfly is a self-hosted panel to deploy apps, static sites and databases on your own server, with automatic SSL and a deploy on every push.'
const jsonLd = (url?: string) => ({
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Dockfly',
  description,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Linux',
  url,
  sameAs: repo,
  license: 'https://www.apache.org/licenses/LICENSE-2.0',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
})
---

<Base {title} {description} {jsonLd}>
  <main id="content">
    <Hero />
    <Facts />
    <Features />
    <Install />
  </main>
</Base>
