---
import '../styles/global.css'

const repo = 'https://github.com/oswaldohuillca/dockfly'
const description =
  'Dockfly is a self-hosted panel to deploy apps, static sites and databases on your own server, with automatic SSL and a deploy on every push.'

// 270° arc meter, same as the panel's (web/src/components/gauge.tsx).
const R = 34
const C = 2 * Math.PI * R
const ARC = C * 0.75
const gauges = [
  { label: 'CPU', value: 23, detail: '4 cores' },
  { label: 'Memory', value: 61, detail: '4.9 of 8 GB' },
  { label: 'Disk', value: 78, detail: '62 of 80 GB' },
]
const tone = (v: number) => (v >= 90 ? 'text-destructive' : v >= 75 ? 'text-amber-500' : 'text-primary')

const apps = [
  { name: 'api', meta: 'ghcr.io/acme/api', status: 'Running' },
  { name: 'postgres', meta: 'postgres:17', status: 'Running' },
  { name: 'web', meta: 'mydomain.com', status: 'Published 2 min ago' },
]

const facts = [
  { value: '1 image', label: 'panel and Traefik together, ~54 MB' },
  { value: 'amd64 · arm64', label: 'runs on a Raspberry Pi too' },
  { value: 'Automatic SSL', label: "Let's Encrypt certificates" },
  { value: 'Just Docker', label: 'nothing else to install' },
]

const more = [
  {
    title: 'Proxy hosts with SSL',
    text: 'Point a domain at a container, a service on the host or an external URL. Automatic certificates, access lists and a different target per path.',
  },
  {
    title: 'Static sites',
    text: 'Drop your dist folder or a .zip. Every upload is an immutable deployment and rolling back is one click. Supports _redirects and _headers.',
  },
  {
    title: 'Multiple servers',
    text: 'One command adds another machine. The agent connects out to the panel, with no ports to open, and its apps keep serving if the panel goes down.',
  },
  {
    title: 'Backups',
    text: 'Scheduled backups for PostgreSQL, MySQL and Redis, kept on the server or in an S3 bucket. Plus a full panel backup to move to another server.',
  },
  {
    title: 'Team and security',
    text: 'Admin, deployer and read-only roles, two-factor authentication, API tokens that expire and builds in unprivileged containers.',
  },
  {
    title: 'Traffic and resources',
    text: 'Requests and p50/p95 latency for every domain, and CPU, memory and disk usage for every server, with nothing extra to set up.',
  },
]

const compose = `services:
  dockfly:
    image: 'ghcr.io/oswaldohuillca/dockfly:latest'
    container_name: dockfly
    restart: unless-stopped
    ports:
      - '80:80'
      - '443:443'
      - '127.0.0.1:81:81'
    environment:
      DOCKFLY_NETWORK: 'dockfly'
    volumes:
      - ./data:/data
      - /var/run/docker.sock:/var/run/docker.sock
    extra_hosts:
      - 'host.docker.internal:host-gateway'`

const btn = 'inline-flex h-11 items-center justify-center px-5 text-sm font-medium transition-colors duration-150'
const btnPrimary = `${btn} bg-primary text-primary-foreground hover:bg-primary/90`
const btnOutline = `${btn} border border-foreground/20 hover:bg-muted`
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Dockfly — deploy on your own server</title>
    <meta name="description" content={description} />
    <meta property="og:title" content="Dockfly — deploy on your own server" />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a href="#content" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-10 focus:bg-card focus:px-3 focus:py-2">
      Skip to content
    </a>

    <header class="mx-auto flex max-w-6xl items-center justify-between px-4 py-5">
      <a href="/" class="flex items-center gap-2.5 text-lg font-semibold tracking-tight">
        <img src="/favicon.svg" alt="" width="32" height="32" />
        Dockfly
      </a>
      <nav aria-label="Main" class="flex items-center gap-1 text-sm">
        <a href="#features" class="hidden px-3 py-2 text-muted-foreground hover:text-foreground sm:block">Features</a>
        <a href="#install" class="hidden px-3 py-2 text-muted-foreground hover:text-foreground sm:block">Install</a>
        <a href={repo} class="px-3 py-2 text-muted-foreground hover:text-foreground">GitHub</a>
      </nav>
    </header>

    <main id="content">
      <section class="mx-auto grid max-w-6xl items-center gap-12 px-4 pb-20 pt-10 lg:grid-cols-[1.05fr_1fr] lg:pb-28 lg:pt-16">
        <div>
          <p class="mb-5 font-mono text-xs uppercase tracking-widest text-highlight-foreground">Self-hosted panel for Docker</p>
          <h1 class="text-4xl font-semibold leading-[1.05] tracking-tight sm:text-5xl lg:text-6xl">
            Deploy on your own server like it's a PaaS.
          </h1>
          <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted-foreground">
            Dockfly publishes your apps, sites and databases with automatic SSL and rebuilds them on every push.
            All in a single Docker image, on a machine you own.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="#install" class={btnPrimary}>Install on your server</a>
            <a href={repo} class={btnOutline}>View the code on GitHub</a>
          </div>
        </div>

        <div
          role="img"
          aria-label="Dockfly panel preview: the server's CPU, memory and disk usage and the list of running apps."
          class="bg-card p-6 shadow-card"
        >
          <div class="flex items-center justify-between">
            <p class="font-semibold tracking-tight">This server</p>
            <p class="flex items-center gap-2 text-xs text-emerald-700 dark:text-emerald-400">
              <span class="size-2 bg-emerald-500"></span>Online
            </p>
          </div>
          <div class="mt-5 grid grid-cols-3 gap-2">
            {
              gauges.map((g) => (
                <div class="text-center">
                  <div class="relative mx-auto w-full max-w-28">
                    <svg viewBox="0 0 80 80" class="w-full" fill="none" stroke-width="7">
                      <g transform="rotate(135 40 40)">
                        <circle cx="40" cy="40" r={R} class="text-muted" stroke="currentColor" stroke-dasharray={`${ARC} ${C}`} />
                        <circle cx="40" cy="40" r={R} class={tone(g.value)} stroke="currentColor" stroke-dasharray={`${(ARC * g.value) / 100} ${C}`} />
                      </g>
                    </svg>
                    <p class="absolute inset-0 flex items-center justify-center text-xl font-semibold tabular-nums tracking-tight">
                      {g.value}%
                    </p>
                  </div>
                  <p class="text-sm font-medium">{g.label}</p>
                  <p class="text-xs text-muted-foreground">{g.detail}</p>
                </div>
              ))
            }
          </div>
          <ul class="mt-6 divide-y divide-border border-t border-border">
            {
              apps.map((a) => (
                <li class="flex items-center justify-between gap-3 py-3">
                  <div class="min-w-0">
                    <p class="text-sm font-medium">{a.name}</p>
                    <p class="truncate font-mono text-xs text-muted-foreground">{a.meta}</p>
                  </div>
                  <p class="flex shrink-0 items-center gap-2 text-xs text-emerald-700 dark:text-emerald-400">
                    <span class="size-2 bg-emerald-500"></span>
                    {a.status}
                  </p>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section aria-label="At a glance" class="border-y border-border bg-card">
        <dl class="mx-auto grid max-w-6xl grid-cols-2 gap-x-6 gap-y-8 px-4 py-10 lg:grid-cols-4">
          {
            facts.map((f) => (
              <div>
                <dt class="text-xl font-semibold tracking-tight">{f.value}</dt>
                <dd class="mt-1 text-sm text-muted-foreground">{f.label}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      <section id="features" class="mx-auto max-w-6xl scroll-mt-8 px-4 py-20 lg:py-28">
        <h2 class="max-w-2xl text-3xl font-semibold tracking-tight sm:text-4xl">
          What a PaaS does, without the bill or the lock-in.
        </h2>

        <div class="mt-12 grid gap-5 lg:grid-cols-12">
          <article class="grid gap-8 bg-card p-6 shadow-card sm:p-8 lg:col-span-7 lg:grid-cols-2">
            <div>
              <h3 class="text-xl font-semibold tracking-tight">Every push, published</h3>
              <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
                Connect GitHub or GitLab in one click and every push to your branch builds and publishes the site or app.
                Other branches get their own preview URL, without touching production.
              </p>
              <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
                Content lives in a CMS? Every site has a deploy hook: a URL that Strapi, or a cron job, calls to rebuild it.
              </p>
            </div>
            <pre class="self-start overflow-x-auto bg-ink p-4 font-mono text-xs leading-6 text-ink-foreground" aria-label="Sample build log"><code><span class="text-ink-muted">push to main · a3f9c1e</span>
$ bun install
<span class="text-ink-muted">  dependencies restored from cache</span>
$ bun run build
<span class="text-ink-muted">  dist/ ready</span>
<span class="text-[oklch(0.809_0.11_122)]">✓ Published to mydomain.com</span></code></pre>
          </article>

          <article class="bg-card p-6 shadow-card sm:p-8 lg:col-span-5">
            <h3 class="text-xl font-semibold tracking-tight">Zero-downtime apps</h3>
            <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
              From an image, a Dockerfile or a docker-compose.yml. The new container starts, passes its health check
              and only then receives traffic. If it fails, the previous version keeps serving.
            </p>
            <p class="mt-5 text-xs font-medium uppercase tracking-wider text-muted-foreground">One-click templates</p>
            <ul class="mt-2 flex flex-wrap gap-2 font-mono text-xs">
              {['PostgreSQL', 'MySQL', 'Redis', 'n8n', 'Uptime Kuma'].map((t) => <li class="bg-muted px-2 py-1">{t}</li>)}
            </ul>
          </article>
        </div>

        <dl class="mt-16 grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
          {
            more.map((m) => (
              <div class="border-t-2 border-primary pt-4">
                <dt class="font-semibold tracking-tight">{m.title}</dt>
                <dd class="mt-2 text-sm leading-relaxed text-muted-foreground">{m.text}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      <section id="install" class="scroll-mt-0 bg-ink text-ink-foreground">
        <div class="mx-auto grid max-w-6xl gap-12 px-4 py-20 lg:grid-cols-[1fr_1.1fr] lg:py-24">
          <div class="min-w-0">
            <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">Installed in two minutes.</h2>
            <p class="mt-4 max-w-md text-ink-muted">All you need is a server with Docker and a domain pointing at it.</p>
            <ol class="mt-10 space-y-7">
              <li class="flex gap-4">
                <span class="font-mono text-sm text-highlight">01</span>
                <p>Save this <code class="font-mono text-sm">docker-compose.yml</code> on your server.</p>
              </li>
              <li class="flex gap-4">
                <span class="font-mono text-sm text-highlight">02</span>
                <div class="min-w-0">
                  <p>Start it.</p>
                  <pre class="mt-2 overflow-x-auto font-mono text-sm text-ink-muted"><code>docker compose up -d</code></pre>
                </div>
              </li>
              <li class="flex gap-4">
                <span class="font-mono text-sm text-highlight">03</span>
                <div class="min-w-0">
                  <p>Open an SSH tunnel and create your admin account at <span class="font-mono text-sm">127.0.0.1:8081</span>.</p>
                  <pre class="mt-2 overflow-x-auto font-mono text-sm text-ink-muted"><code>ssh -L 8081:127.0.0.1:81 user@your-server</code></pre>
                </div>
              </li>
            </ol>
            <p class="mt-10 text-sm text-ink-muted">
              The panel only listens locally on purpose.{' '}
              <a href={`${repo}#instalación`} class="text-ink-foreground underline underline-offset-4 hover:no-underline">The full guide</a>{' '}
              covers publishing it over HTTPS and every option.
            </p>
          </div>

          <div class="min-w-0 self-start border border-white/10">
            <div class="flex items-center justify-between border-b border-white/10 px-4 py-2">
              <span class="font-mono text-xs text-ink-muted">docker-compose.yml</span>
              <button type="button" id="copy" class="px-2 py-1 text-xs font-medium text-ink-foreground hover:bg-white/10">Copy</button>
            </div>
            <pre class="overflow-x-auto p-4 font-mono text-xs leading-6 sm:text-sm sm:leading-6"><code id="compose">{compose}</code></pre>
          </div>
        </div>
      </section>
    </main>

    <footer class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-4 py-8 text-sm text-muted-foreground">
      <p class="flex items-center gap-2">
        <img src="/favicon.svg" alt="" width="20" height="20" />
        Dockfly, for people who run their own infrastructure.
      </p>
      <nav aria-label="Footer" class="flex gap-5">
        <a href={repo} class="hover:text-foreground">GitHub</a>
        <a href={`${repo}/releases`} class="hover:text-foreground">Releases</a>
        <a href={`${repo}#readme`} class="hover:text-foreground">Documentation</a>
      </nav>
    </footer>

    <script>
      const button = document.getElementById('copy')!
      button.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(document.getElementById('compose')!.textContent ?? '')
          button.textContent = 'Copied'
        } catch {
          button.textContent = 'Could not copy'
        }
        setTimeout(() => (button.textContent = 'Copy'), 2000)
      })
    </script>
  </body>
</html>
