---
const more = [
  {
    span: 'lg:col-span-4',
    title: 'Proxy hosts with SSL',
    text: 'Point a domain at a container, a service on the host or an external URL. Automatic certificates, access lists and a different target per path.',
    rows: [
      ['app.mydomain.com', 'api:3000'],
      ['mydomain.com/blog', 'ghost:2368'],
      ['grafana.mydomain.com', 'host:3001'],
    ],
  },
  {
    span: 'lg:col-span-4',
    title: 'Static sites',
    text: 'Drop your dist folder or a .zip. Every upload is an immutable deployment and rolling back is one click. Supports _redirects and _headers.',
    rows: [
      ['#42 · a3f9c1e', 'Live'],
      ['#41 · 71b02dd', 'Roll back'],
      ['#40 · 5e08b13', 'Roll back'],
    ],
  },
  {
    span: 'lg:col-span-4',
    title: 'Multiple servers',
    text: 'One command adds another machine. The agent connects out to the panel, with no ports to open, and its apps keep serving if the panel goes down.',
    rows: [
      ['This server', 'Online'],
      ['fra-1', 'Online'],
      ['raspberry-pi', 'Online'],
    ],
  },
  {
    span: 'lg:col-span-5',
    title: 'Backups',
    text: 'Scheduled backups for PostgreSQL, MySQL and Redis, kept on the server or in an S3 bucket. Plus a full panel backup to move to another server.',
    rows: [
      ['postgres', 'Daily · S3'],
      ['mysql', 'Every 6 h · Local'],
      ['redis', 'Weekly · S3'],
    ],
  },
  {
    span: 'lg:col-span-7',
    title: 'Team, security and traffic',
    text: 'Admin, deployer and read-only roles, two-factor authentication, API tokens that expire and builds in unprivileged containers. Requests and p50/p95 latency for every domain, CPU, memory and disk for every server, with nothing extra to set up.',
    rows: [
      ['ana', 'Admin · 2FA'],
      ['ci-token', 'Expires in 30 days'],
      ['api.mydomain.com', 'p95 212 ms'],
    ],
  },
]
---

<section id="features" class="mx-auto max-w-6xl scroll-mt-8 px-4 py-20 lg:py-28">
  <h2 class="max-w-2xl text-balance text-3xl font-semibold tracking-tight sm:text-4xl">
    What a PaaS does, without the bill or the lock-in.
  </h2>

  <div class="mt-12 grid gap-5 lg:grid-cols-12">
    <article class="grid gap-8 bg-card p-6 shadow-card sm:p-8 lg:col-span-7 lg:grid-cols-2">
      <div>
        <h3 class="text-xl font-semibold tracking-tight">Every push, published</h3>
        <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
          Connect GitHub or GitLab in one click and every push to your branch builds and publishes the site or app.
          Other branches get their own preview URL, without touching production.
        </p>
        <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
          Content lives in a CMS? Every site has a deploy hook: a URL that Strapi, or a cron job, calls to rebuild it.
        </p>
      </div>
      <pre class="self-start overflow-x-auto border border-white/10 bg-ink p-4 font-mono text-xs leading-6 text-ink-foreground" aria-label="Sample build log"><code><span class="text-ink-muted">push to main · a3f9c1e</span>
$ bun install
<span class="text-ink-muted">  dependencies restored from cache</span>
$ bun run build
<span class="text-ink-muted">  dist/ ready</span>
<span class="text-[oklch(0.809_0.11_122)]">✓ Published to mydomain.com</span></code></pre>
    </article>

    <article class="flex flex-col bg-card p-6 shadow-card sm:p-8 lg:col-span-5">
      <h3 class="text-xl font-semibold tracking-tight">Zero-downtime apps</h3>
      <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
        From an image, a Dockerfile or a compose.yml. The new container starts, passes its health check
        and only then receives traffic. If it fails, the previous version keeps serving.
      </p>
      <p class="mt-auto pt-8 text-xs font-medium uppercase tracking-wider text-muted-foreground">One-click templates</p>
      <ul class="mt-2 flex flex-wrap gap-2 font-mono text-xs">
        {['PostgreSQL', 'MySQL', 'Redis', 'n8n', 'Uptime Kuma'].map((t) => <li class="bg-muted px-2 py-1">{t}</li>)}
      </ul>
    </article>
  </div>

  <div class="mt-5 grid gap-5 lg:grid-cols-12">
    {
      more.map((m) => (
        <article class={`flex flex-col bg-card p-6 shadow-card ${m.span}`}>
          <h3 class="text-lg font-semibold tracking-tight">{m.title}</h3>
          <p class="mt-2 pb-5 text-sm leading-relaxed text-muted-foreground">{m.text}</p>
          <ul aria-hidden="true" class="mt-auto divide-y divide-border border-t border-border font-mono text-xs">
            {m.rows.map(([name, value]) => (
              <li class="flex justify-between gap-3 py-2">
                <span class="truncate">{name}</span>
                <span class="shrink-0 text-muted-foreground">{value}</span>
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
</section>
